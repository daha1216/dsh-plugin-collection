{
  "$schema": "https://raw.githubusercontent.com/daha1216/dsh-plugin-collection/main/plugins.schema.json",
  "catalogVersion": "1.13.0",
  "updatedAt": "2026-08-26",
  "install": {
    "command": "npx --yes -p @deepseek-ai/dsh dsh plugin --profile web add",
    "profile": "web",
    "sourcePolicy": "github-or-npm"
  },
  "plugins": [
    {
      "id": "dsh-better-sidebar",
      "name": "dsh-better-sidebar",
      "version": "0.16.1",
      "description": "VS Code 风格右侧边栏，提供文件浏览、编辑器、终端、Git 和浏览器面板。",
      "source": "https://github.com/omdsh-dev/DSH-better-sidebar",
      "install": "github:omdsh-dev/DSH-better-sidebar",
      "update": "dsh plugin --profile web add dsh-better-sidebar@latest"
    },
    {
      "id": "dshmarket",
      "name": "dshmarket",
      "version": "1.29.2",
      "description": "DSH 社区插件市场，支持浏览、搜索和一键安装插件。",
      "source": "https://github.com/dsh-market/dsh-market",
      "install": "github:dsh-market/dsh-market",
      "update": "dsh plugin --profile web add dshmarket"
    },
    {
      "id": "dsh-super-injector",
      "name": "@dsh-external/dsh-super-injector",
      "version": "0.3.3",
      "description": "运行时注入、热重载、卸载本地 DSH 插件，并提供插件管理界面。",
      "source": "https://github.com/yjh051108/dsh-super-injector",
      "install": "github:yjh051108/dsh-super-injector",
      "update": "dsh plugin --profile web add github:yjh051108/dsh-super-injector"
    },
    {
      "id": "dsh-notification",
      "name": "dsh-notification",
      "version": "0.1.3",
      "description": "请求完成后的浏览器桌面通知，支持结果和关键词过滤。",
      "source": "https://github.com/omdsh-dev/dsh-notification",
      "install": "github:omdsh-dev/dsh-notification",
      "update": "dsh plugin --profile web add https://github.com/omdsh-dev/dsh-notification/archive/refs/tags/v0.1.3.tar.gz"
    },
    {
      "id": "dsh-context",
      "name": "dsh-context",
      "version": "0.31.0",
      "description": "查看上下文的组成、用量和演变情况。",
      "source": "https://github.com/bowenliang123/dsh-context",
      "install": "github:bowenliang123/dsh-context",
      "update": "dsh plugin --profile web add dsh-context@latest"
    },
    {
      "id": "dsh-at-file",
      "name": "dsh-at-file",
      "version": "0.6.8",
      "description": "支持 Codex 风格的 @path 工作区路径引用。",
      "source": "https://github.com/omdsh-dev/dsh-at-file",
      "install": "github:omdsh-dev/dsh-at-file",
      "update": "dsh plugin --profile web add https://github.com/omdsh-dev/dsh-at-file/archive/refs/tags/v0.6.8.tar.gz"
    },
    {
      "id": "dsh-skills",
      "name": "dsh-skills",
      "version": "0.1.1",
      "description": "聚合和管理全局、项目及 .skill-package 技能。",
      "source": "https://github.com/CocoSgt/dsh-skills",
      "install": "github:CocoSgt/dsh-skills",
      "update": "dsh plugin --profile web add dsh-skills"
    },
    {
      "id": "merge-tool-calls",
      "name": "@huanlin/dsh-plugin-merge-tool-calls",
      "version": "0.2.2",
      "description": "合并工具调用，减少多个工具调用造成的交互噪声。",
      "source": "https://github.com/HuanLinOTO/dsh-plugin-merge-tool-calls",
      "install": "github:huanlinoto/dsh-plugin-merge-tool-calls",
      "update": "dsh plugin --profile web add \"github:huanlinoto/dsh-plugin-merge-tool-calls\""
    },
    {
      "id": "dsh-pet",
      "name": "dsh-pet",
      "version": "0.1.8",
      "description": "在 DSH 网页界面显示可活动的桌面宠物。",
      "source": "https://github.com/PC2005-cloud/dsh-pet",
      "install": "github:PC2005-cloud/dsh-pet#path:dsh-pet",
      "update": "dsh plugin --profile web add dsh-pet"
    },
    {
      "id": "dsh-pocket",
      "name": "dsh-pocket",
      "version": "1.14.5",
      "description": "通过手机扫码访问并同步电脑上的 DSH，支持局域网和公网。",
      "source": "https://github.com/shaobeichen/dsh-pocket",
      "install": "github:shaobeichen/dsh-pocket",
      "update": "dsh plugin --profile web update dsh-pocket --latest -w"
    },
    {
      "id": "dsh-archive-manager",
      "name": "@michengai/dsh-archive-manager",
      "version": "0.1.14",
      "description": "管理已归档的 DSH 会话。",
      "source": "https://github.com/MichengAI/dsh-archive-manager",
      "install": "@michengai/dsh-archive-manager@latest",
      "update": "dsh plugin --profile web add @michengai/dsh-archive-manager@latest"
    },
    {
      "id": "dsh-drag-and-drop",
      "name": "@omdsh-dev/dsh-drag-and-drop",
      "version": "0.1.6",
      "description": "将本地文件拖入 DSH Web UI，并插入原始文件路径。",
      "source": "https://github.com/omdsh-dev/dsh-drag-and-drop",
      "install": "github:omdsh-dev/dsh-drag-and-drop",
      "update": "dsh plugin --profile web update github:omdsh-dev/dsh-drag-and-drop"
    },
    {
      "id": "dsh-custom-provider-settings",
      "name": "dsh-custom-provider-settings",
      "version": "0.5.0",
      "description": "为自定义 Provider 增加请求头、图片输入和推理设置。",
      "source": "https://github.com/supersealwqas/dsh-custom-provider-settings",
      "install": "github:supersealwqas/dsh-custom-provider-settings",
      "update": "npx --yes -p @deepseek-ai/dsh dsh plugin --profile web add github:supersealwqas/dsh-custom-provider-settings"
    },
    {
      "id": "dsh-opencode-go-usage",
      "name": "@xueayi/dsh-opencode-go-usage",
      "version": "0.1.6",
      "description": "在悬浮 Web 面板中实时监控 OpenCode Go 的 5 小时滚动 / 周 / 月配额并展示用量。",
      "source": "https://github.com/xueayi/dsh-opencode-go-usage",
      "install": "github:xueayi/dsh-opencode-go-usage",
      "update": "dsh plugin --profile web update @xueayi/dsh-opencode-go-usage"
    },
    {
      "id": "dsh-agent-teams",
      "name": "@nanmicoder/dsh-agent-teams",
      "version": "0.1.13",
      "description": "多智能体团队协作：队长、成员、带依赖的任务与消息传递，Web 界面提供树状监控。",
      "source": "https://github.com/NanmiCoder/dsh-agent-teams",
      "install": "github:NanmiCoder/dsh-agent-teams",
      "update": "dsh plugin --profile web add @nanmicoder/dsh-agent-teams"
    },
    {
      "id": "dsh-easyrewrite",
      "name": "dsh-easyrewrite",
      "version": "2.3.0",
      "description": "在 Web 里内联编辑与撤回自己的消息：气泡原位编辑、无痕替换、版本翻页器。",
      "source": "https://github.com/Renzic-Stone/DSH-EasyRewrite",
      "install": "github:Renzic-Stone/DSH-EasyRewrite",
      "update": "dsh plugin --profile web add github:Renzic-Stone/DSH-EasyRewrite"
    },
    {
      "id": "dsh-font",
      "name": "dsh-font",
      "version": "1.1.0",
      "description": "为 Web 界面换字体：99 个界面字体 + 31 个代码字体，中西文自动搭配，即选即生效。",
      "source": "https://github.com/tianyhjg-lab/dsh-font",
      "install": "github:tianyhjg-lab/dsh-font",
      "update": "dsh plugin --profile web add github:tianyhjg-lab/dsh-font"
    },
    {
      "id": "dsh-docs-panel",
      "name": "dsh-docs-panel",
      "version": "0.1.0",
      "description": "侧边栏里的「全局文档」：全局 Markdown 笔记，任何工作区随时可读（依赖 dsh-better-sidebar）。",
      "source": "https://github.com/mlosun/dsh-docs-panel",
      "install": "github:mlosun/dsh-docs-panel",
      "update": "dsh plugin --profile web add dsh-docs-panel"
    },
    {
      "id": "billion-context-dsh",
      "name": "billion-context-dsh",
      "version": "0.2.13",
      "description": "通过模型驱动的上下文裁剪管理 DSH 上下文，作为 CompactionEngine 后端工作。",
      "source": "https://github.com/Tyan66666/billion-context-dsh",
      "install": "billion-context-dsh@0.2.13",
      "update": "dsh plugin --profile web add billion-context-dsh@latest"
    }
  ]
}
