{
  "$schema": "https://raw.githubusercontent.com/daha1216/dsh-plugin-collection/main/plugins.schema.json",
  "catalogVersion": "1.42.1",
  "updatedAt": "2026-10-09",
  "install": {
    "command": "npx --yes -p @deepseek-ai/dsh dsh plugin --profile web add",
    "profile": "web",
    "sourcePolicy": "github-or-npm",
    "windowsEntry": "install.cmd (double-click; auto-clones when not in repo)"
  },
  "plugins": [
    {
      "id": "dsh-better-reasoning-effort",
      "name": "dsh-better-reasoning-effort",
      "version": "0.5.2",
      "description": "在官方 Models 页内嵌配置第三方模型的推理强度（Effort）、输入模态、请求头与端点兼容项",
      "source": "https://github.com/HaoyueQin/dsh-better-reasoning-effort",
      "install": "dsh-better-reasoning-effort@0.5.2",
      "update": "dsh plugin --profile web add dsh-better-reasoning-effort"
    },
    {
      "id": "dsh-pocket",
      "name": "dsh-pocket",
      "version": "2.10.6",
      "description": "手机扫码同步电脑端 DSH，支持移动端操作",
      "source": "https://github.com/daha1216/dsh-pocket",
      "install": "github:daha1216/dsh-pocket",
      "update": "dsh plugin --profile web update dsh-pocket --latest -w"
    },
    {
      "id": "anysearch-dsh",
      "name": "@anysearch/anysearch-dsh",
      "version": "0.1.7",
      "description": "为 Agent 提供网页实时搜索与正文抓取能力",
      "source": "https://github.com/anysearch-team/anysearch-dsh",
      "install": "@anysearch/anysearch-dsh",
      "update": "npx -y @deepseek-ai/dsh plugin --profile web update @anysearch/anysearch-dsh"
    },
    {
      "id": "billion-context",
      "name": "billion-context",
      "version": "0.1.189",
      "description": "动态压缩长会话上下文：小窗口跑数十亿 token 超长会话，token 节省约 5 倍",
      "source": "https://github.com/ranxianglei/billion-context",
      "install": "billion-context@0.1.189",
      "update": "dsh plugin --profile web add billion-context"
    },
    {
      "id": "dsh-retrace",
      "name": "dsh-retrace",
      "version": "0.4.49",
      "description": "消息撤回、编辑重发与重新生成，同步回退修改过的文件",
      "source": "https://github.com/daha1216/dsh-retrace",
      "install": "github:daha1216/dsh-retrace",
      "update": "dsh plugin --profile web add dsh-retrace"
    },
    {
      "id": "dsh-watcher",
      "name": "dsh-watcher",
      "version": "0.6.3",
      "description": "会话工作路径观测面板 · 跨会话模型耗时与费用统计",
      "source": "https://github.com/daha1216/dsh-watcher",
      "install": "github:daha1216/dsh-watcher",
      "update": "dsh plugin --profile web add github:daha1216/dsh-watcher"
    },
    {
      "id": "dsh-update-checker",
      "name": "dsh-update-checker",
      "version": "0.3.0",
      "description": "一键检查已装插件的上游更新（只检查不更新），展示更新内容",
      "source": "https://github.com/daha1216/dsh-update-checker",
      "install": "github:daha1216/dsh-update-checker",
      "update": "dsh plugin --profile web add github:daha1216/dsh-update-checker"
    },
    {
      "id": "dsh-gateway-provider",
      "name": "dsh-gateway-provider",
      "version": "1.1.1",
      "description": "通用 LLM 网关接入：将 newapi / LiteLLM / Higress 等 OpenAI 兼容网关挂载为模型提供方，自动发现模型列表，按 OpenAI / Anthropic / Gemini 原生协议分发",
      "source": "https://github.com/daha1216/dsh-gateway-provider",
      "install": "github:daha1216/dsh-gateway-provider",
      "update": "dsh plugin --profile web add github:daha1216/dsh-gateway-provider"
    },
    {
      "id": "skills-manager",
      "name": "@local/skills-manager",
      "version": "0.1.0",
      "description": "在设置页新增「技能」管理页：列出 / 查看 / 新建 / 编辑 / 删除本地技能，切换模型调用与用户调用策略",
      "source": "https://github.com/daha1216/dsh-skills-manager",
      "install": "github:daha1216/dsh-skills-manager",
      "update": "dsh plugin --profile web add github:daha1216/dsh-skills-manager"
    }
  ]
}
