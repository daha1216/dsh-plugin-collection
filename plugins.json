{
  "$schema": "https://raw.githubusercontent.com/daha1216/dsh-plugin-collection/main/plugins.schema.json",
  "catalogVersion": "1.57.2",
  "updatedAt": "2026-11-05",
  "install": {
    "command": "npx --yes -p @deepseek-ai/dsh dsh plugin --profile web add",
    "profile": "web",
    "sourcePolicy": "github-or-npm",
    "windowsEntry": "install.cmd (double-click; auto-clones when not in repo)"
  },
  "plugins": [
    {
      "id": "dsh-better-reasoning-effort",
      "name": "dsh-better-reasoning-effort",
      "version": "0.5.4",
      "description": "在官方 Models 页内嵌配置第三方模型的推理强度（Effort）、输入模态、请求头与端点兼容项",
      "source": "https://github.com/HaoyueQin/dsh-better-reasoning-effort",
      "install": "dsh-better-reasoning-effort@0.5.4",
      "update": "dsh plugin --profile web add dsh-better-reasoning-effort"
    },
    {
      "id": "dsh-pocket",
      "name": "dsh-pocket",
      "version": "3.0.9",
      "description": "手机扫码同步电脑端 DSH，支持移动端操作；具备完整会话与工具代理、安全限流及 Cloudflare Named Tunnel 支持",
      "source": "https://github.com/daha1216/dsh-pocket",
      "install": "github:daha1216/dsh-pocket",
      "update": "dsh plugin --profile web add github:daha1216/dsh-pocket -w"
    },
    {
      "id": "anysearch-dsh",
      "name": "@anysearch/anysearch-dsh",
      "version": "0.1.8",
      "description": "为 Agent 提供网页实时搜索与正文抓取能力",
      "source": "https://github.com/anysearch-team/anysearch-dsh",
      "install": "@anysearch/anysearch-dsh",
      "update": "npx -y @deepseek-ai/dsh plugin --profile web update @anysearch/anysearch-dsh"
    },
    {
      "id": "billion-context",
      "name": "billion-context",
      "version": "0.1.211",
      "description": "动态压缩长会话上下文：小窗口跑数十亿 token 超长会话，支持消息时间戳、陪伴型 Prompt Pack 与冻结恢复，token 节省约 5 倍",
      "source": "https://github.com/ranxianglei/billion-context",
      "install": "billion-context@0.1.211",
      "update": "bili update"
    },
    {
      "id": "dsh-mnemon",
      "name": "dsh-mnemon",
      "version": "0.5.38",
      "description": "可组合的视图化记忆系统：可插拔记忆源与策略，开箱即用分层记忆（Memory Spaces / Providers），优化会话切换读取开销与审查生命周期",
      "source": "https://github.com/omdsh-dev/dsh-mnemon",
      "install": "dsh-mnemon@0.5.38",
      "update": "dsh plugin --profile web add dsh-mnemon"
    },
    {
      "id": "dsh-our-free-model",
      "name": "dsh-our-free-model",
      "version": "2.8.0",
      "description": "免费模型接入：无需登录或 API Key 即可用 DeepSeek V4.1 Flash、Kimi K3 等前沿模型，免费道整形层对齐参考网关，带数据看板与本地网关",
      "source": "https://github.com/Ebony-Vinyl/dsh-our-free-model",
      "install": "https://github.com/Ebony-Vinyl/dsh-our-free-model/releases/download/v2.8.0/dsh-our-free-model-2.8.0.tgz",
      "update": "dsh plugin --profile web add https://github.com/Ebony-Vinyl/dsh-our-free-model/releases/download/v2.8.0/dsh-our-free-model-2.8.0.tgz"
    },
    {
      "id": "dsh-retrace",
      "name": "dsh-retrace",
      "version": "0.4.82",
      "description": "消息撤回、编辑重发与重新生成，同步回退修改过的文件；0.4.82 请求级配置隔离、fold 原始端点校验、快照 fail-closed 与存储原子写",
      "source": "https://github.com/daha1216/dsh-retrace",
      "install": "github:daha1216/dsh-retrace",
      "update": "dsh plugin --profile web add dsh-retrace"
    },
    {
      "id": "dsh-update-checker",
      "name": "dsh-update-checker",
      "version": "0.7.3",
      "description": "一键检查已装插件的上游更新，点「一键更新」原生创建对话并预填更新提示词，适配多插件紧凑弹性侧栏",
      "source": "https://github.com/daha1216/dsh-update-checker",
      "install": "github:daha1216/dsh-update-checker",
      "update": "dsh plugin --profile web add github:daha1216/dsh-update-checker"
    },
    {
      "id": "skills-manager",
      "name": "@local/skills-manager",
      "version": "0.3.4",
      "description": "在设置页新增「技能」管理页：双根隔离、无损 frontmatter 读写、列出 / 查看 / 编辑 / 删除技能并切换调用策略",
      "source": "https://github.com/daha1216/dsh-skills-manager",
      "install": "github:daha1216/dsh-skills-manager",
      "update": "dsh plugin --profile web add github:daha1216/dsh-skills-manager"
    },
    {
      "id": "dsh-ops",
      "name": "dsh-ops",
      "version": "0.4.4",
      "description": "Rust 原生文件工具集（读、搜索、修改、文档读取、工具发现）与随包 MSYS bash，跨平台运行权限修复，替换反复失败的原生 shell 调用",
      "source": "https://github.com/T-Auto/dsh-ops",
      "install": "dsh-ops@0.4.4",
      "update": "npx --yes dsh-ops@latest install --profile web"
    },
    {
      "id": "dsh-client-auto-continue",
      "name": "dsh-client-auto-continue",
      "version": "0.17.1",
      "description": "请求因网络等非人为原因中断时，自动发送本地化的「继续」提示，修复移动端输入框排版及回滚/变量异常兼容",
      "source": "https://github.com/HsiangNianian/dsh-auto-continue",
      "install": "dsh-client-auto-continue@0.17.1",
      "update": "dsh plugin --profile web add dsh-client-auto-continue@latest"
    },
    {
      "id": "dsh-context",
      "name": "dsh-context",
      "version": "0.79.0",
      "description": "上下文洞察与管理：新增命令执行与工具调用统计卡片，时间线头部轻量化持久化（缓存缩减 69%），优化会话链路与用量看板",
      "source": "https://github.com/bowenliang123/dsh-context",
      "install": "dsh-context@0.79.0",
      "update": "dsh plugin --profile web update dsh-context@latest"
    },
    {
      "id": "dsh-desktop-notify-win",
      "name": "dsh-desktop-notify-win",
      "version": "0.4.0",
      "description": "Windows 桌面通知：会话空闲、待审批、提问与出错时弹系统通知，带设置页、实时预览与预设",
      "source": "https://github.com/xiaotie3088/dsh-desktop-notify-win",
      "install": "github:xiaotie3088/dsh-desktop-notify-win",
      "update": "dsh plugin --profile web add github:xiaotie3088/dsh-desktop-notify-win"
    },
    {
      "id": "dsh-computer-use-win",
      "name": "dsh-computer-use-win",
      "version": "0.5.3",
      "description": "让 DSH 看懂并操作 Windows 桌面与网页：24 个原生桌面/浏览器工具，支持 UI 自动化树、OCR、截图、按键输入与窗口管理",
      "source": "https://github.com/Yu-tao-Li/dsh-computer-use-win",
      "install": "dsh-computer-use-win@0.5.3",
      "update": "dsh plugin --profile web add dsh-computer-use-win"
    }
  ]
}
