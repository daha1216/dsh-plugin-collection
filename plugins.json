{
  "$schema": "https://raw.githubusercontent.com/daha1216/dsh-plugin-collection/main/plugins.schema.json",
  "catalogVersion": "1.33.0",
  "updatedAt": "2026-09-14",
  "install": {
    "command": "npx --yes -p @deepseek-ai/dsh dsh plugin --profile web add",
    "profile": "web",
    "sourcePolicy": "github-or-npm",
    "windowsEntry": "install.cmd (double-click; auto-clones when not in repo)"
  },
  "plugins": [
    {
      "id": "dsh-better-reasoning-effort",
      "name": "dsh-better-reasoning-effort",
      "version": "0.3.10",
      "description": "配置第三方模型的推理强度（Effort）与输入模态",
      "source": "https://github.com/HaoyueQin/dsh-better-reasoning-effort",
      "install": "github:HaoyueQin/dsh-better-reasoning-effort",
      "update": "dsh plugin --profile web add github:HaoyueQin/dsh-better-reasoning-effort"
    },
    {
      "id": "dshmarket",
      "name": "dshmarket",
      "version": "1.46.1",
      "description": "官方社区插件市场，支持浏览、搜索与一键安装",
      "source": "https://github.com/dsh-market/dsh-market",
      "install": "github:dsh-market/dsh-market",
      "update": "dsh plugin --profile web add dshmarket"
    },
    {
      "id": "dsh-skills",
      "name": "dsh-skills",
      "version": "0.1.1",
      "description": "统一管理全局与项目级 Agent 技能包",
      "source": "https://github.com/CocoSgt/dsh-skills",
      "install": "github:CocoSgt/dsh-skills",
      "update": "dsh plugin --profile web add dsh-skills"
    },
    {
      "id": "dsh-pet",
      "name": "dsh-pet",
      "version": "0.2.8",
      "description": "在页面右下角显示可互动的桌面宠物",
      "source": "https://github.com/PC2005-cloud/dsh-pet",
      "install": "dsh-pet@0.2.8",
      "update": "dsh plugin --profile web add dsh-pet"
    },
    {
      "id": "dsh-pocket",
      "name": "dsh-pocket",
      "version": "2.10.3-daha.1",
      "description": "手机扫码同步电脑端 DSH，支持移动端操作",
      "source": "https://github.com/daha1216/dsh-pocket",
      "install": "github:daha1216/dsh-pocket",
      "update": "dsh plugin --profile web update dsh-pocket --latest -w"
    },
    {
      "id": "dsh-archive-manager",
      "name": "@michengai/dsh-archive-manager",
      "version": "0.1.40",
      "description": "浏览、检索与恢复已归档的历史会话",
      "source": "https://github.com/MichengAI/dsh-archive-manager",
      "install": "@michengai/dsh-archive-manager@latest",
      "update": "dsh plugin --profile web add @michengai/dsh-archive-manager@latest --registry=https://registry.npmjs.org/"
    },
    {
      "id": "dsh-opencode-go-usage",
      "name": "@xueayi/dsh-opencode-go-usage",
      "version": "0.1.6",
      "description": "悬浮监控 OpenCode Go 滚动配额与剩余用量",
      "source": "https://github.com/xueayi/dsh-opencode-go-usage",
      "install": "github:xueayi/dsh-opencode-go-usage",
      "update": "dsh plugin --profile web update @xueayi/dsh-opencode-go-usage"
    },
    {
      "id": "dsh-all-usage",
      "name": "dsh-all-usage",
      "version": "1.1.9",
      "description": "多维度统计 Token 用量、费用消耗与热力图",
      "source": "https://github.com/ParticleLight/dsh-all-usage",
      "install": "github:ParticleLight/dsh-all-usage",
      "update": "dsh plugin --profile web add github:ParticleLight/dsh-all-usage"
    },
    {
      "id": "anysearch-dsh",
      "name": "@anysearch/anysearch-dsh",
      "version": "0.1.4",
      "description": "为 Agent 提供网页实时搜索与正文抓取能力",
      "source": "https://github.com/anysearch-team/anysearch-dsh",
      "install": "@anysearch/anysearch-dsh",
      "update": "npx -y @deepseek-ai/dsh plugin --profile web update @anysearch/anysearch-dsh"
    },
    {
      "id": "billion-context-dsh",
      "name": "billion-context-dsh",
      "version": "0.2.22",
      "description": "动态压缩长会话上下文，防止超出模型窗口",
      "source": "https://github.com/Tyan66666/billion-context-dsh",
      "install": "billion-context-dsh@0.2.22",
      "update": "dsh plugin --profile web add billion-context-dsh"
    },
    {
      "id": "deepseek-idesign",
      "name": "deepseek-idesign",
      "version": "0.2.2",
      "description": "iPolloWork 设计工作室：对话生成设计稿并套用精选设计模板",
      "source": "https://github.com/Devin-AXIS/iPolloWork",
      "install": "deepseek-idesign@0.2.2",
      "update": "dsh plugin --profile web add deepseek-idesign"
    },
    {
      "id": "deepseek-ippt",
      "name": "deepseek-ippt",
      "version": "0.1.2",
      "description": "iPolloWork PPT 工作室：对话生成幻灯片并套用精选模板",
      "source": "https://github.com/Devin-AXIS/iPolloWork",
      "install": "deepseek-ippt@0.1.2",
      "update": "dsh plugin --profile web add deepseek-ippt"
    },
    {
      "id": "deepseek-ivideo",
      "name": "deepseek-ivideo",
      "version": "0.1.0",
      "description": "iPolloWork 视频工作室：对话生成可编辑视频（HyperFrames 模板）",
      "source": "https://github.com/Devin-AXIS/iPolloWork",
      "install": "deepseek-ivideo@0.1.0",
      "update": "dsh plugin --profile web add deepseek-ivideo"
    },
    {
      "id": "dsh-retrace",
      "name": "dsh-retrace",
      "version": "0.4.40",
      "description": "消息撤回、编辑重发与重新生成，同步回退修改过的文件",
      "source": "https://github.com/daha1216/dsh-retrace",
      "install": "github:daha1216/dsh-retrace",
      "update": "dsh plugin --profile web add dsh-retrace"
    },
    {
      "id": "dsh-font-customizer",
      "name": "dsh-font-customizer",
      "version": "0.1.0",
      "description": "自定义 Web 界面字体、代码字体与字号",
      "source": "https://github.com/daha1216/dsh-font-customizer",
      "install": "github:daha1216/dsh-font-customizer",
      "update": "dsh plugin --profile web add github:daha1216/dsh-font-customizer"
    },
    {
      "id": "dsh-watcher",
      "name": "dsh-watcher",
      "version": "0.4.0-insights.1",
      "description": "HUD 悬浮球展示会话运行状态与模型实时用量",
      "source": "https://github.com/aa2246740/dsh-watcher",
      "install": "github:aa2246740/dsh-watcher",
      "update": "dsh plugin --profile web add github:aa2246740/dsh-watcher"
    },
    {
      "id": "dsh-plugin-oauth-subs",
      "name": "dsh-plugin-oauth-subs",
      "version": "0.0.89",
      "description": "接入 ChatGPT、Grok、Copilot 等官方订阅账号",
      "source": "https://github.com/xxww0098/dsh-plugin-oauth-subs",
      "install": "github:xxww0098/dsh-plugin-oauth-subs",
      "update": "dsh plugin --profile web add https://github.com/xxww0098/dsh-plugin-oauth-subs"
    }
  ]
}
